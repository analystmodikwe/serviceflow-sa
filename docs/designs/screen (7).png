<!-- Client-side Interactive Filter Script -->
<script>
    (function() {
      const searchInput = document.getElementById('searchInput');
      const locationSelect = document.getElementById('locationSelect');
      const sortSelect = document.getElementById('sortSelect');
      const searchBtn = document.getElementById('searchBtn');
      const categoryChips = document.querySelectorAll('.category-chip');
      const cards = document.querySelectorAll('.provider-card');
      const providerGrid = document.getElementById('providerGrid');
      const emptyState = document.getElementById('emptyState');
      const emptySearchTerm = document.getElementById('emptySearchTerm');
      const resetFiltersBtn = document.getElementById('resetFiltersBtn');
      const resultsCount = document.getElementById('resultsCount');
      const toggleEmptyDemo = document.getElementById('toggleEmptyDemo');
      const quickSuggestChips = document.querySelectorAll('.quick-suggest-chip');

      let currentCategory = 'all';

      function applyFilters() {
        const query = (searchInput.value || '').trim().toLowerCase();
        const selectedLoc = locationSelect.value;
        let visibleCount = 0;

        cards.forEach(card => {
          const cardCat = card.dataset.category;
          const cardLoc = card.dataset.location;
          const cardText = card.innerText.toLowerCase();

          const matchesCat = currentCategory === 'all' || cardCat === currentCategory;
          const matchesLoc = selectedLoc === 'all' || cardLoc === selectedLoc;
          const matchesQuery = !query || cardText.includes(query);

          if (matchesCat && matchesLoc && matchesQuery) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (visibleCount === 0) {
          providerGrid.classList.add('hidden');
          emptyState.classList.remove('hidden');
          emptyState.classList.add('flex');
          emptySearchTerm.textContent = query || (selectedLoc !== 'all' ? selectedLoc : currentCategory);
          resultsCount.textContent = 'Showing 0 providers';
        } else {
          providerGrid.classList.remove('hidden');
          emptyState.classList.add('hidden');
          emptyState.classList.remove('flex');
          resultsCount.textContent = 'Showing ' + visibleCount + ' providers';
        }
      }

      function sortCards() {
        const sortVal = sortSelect.value;
        const cardsArray = Array.from(cards);

        cardsArray.sort((a, b) => {
          if (sortVal === 'price-low') {
            return Number(a.dataset.price) - Number(b.dataset.price);
          } else if (sortVal === 'rating') {
            return Number(b.dataset.rating) - Number(a.dataset.rating);
          }
          return 0; // recommended default
        });

        cardsArray.forEach(card => providerGrid.appendChild(card));
      }

      categoryChips.forEach(chip => {
        chip.addEventListener('click', () => {
          categoryChips.forEach(c => {
            c.classList.remove('bg-primary-container', 'text-on-primary', 'shadow-sm');
            c.classList.add('bg-surface-container-lowest', 'text-on-surface');
          });
          chip.classList.add('bg-primary-container', 'text-on-primary', 'shadow-sm');
          chip.classList.remove('bg-surface-container-lowest', 'text-on-surface');

          currentCategory = chip.dataset.cat;
          applyFilters();
        });
      });

      searchBtn.addEventListener('click', applyFilters);
      searchInput.addEventListener('keyup', (e) => {
        if (e.key === 'Enter') applyFilters();
      });
      locationSelect.addEventListener('change', applyFilters);
      sortSelect.addEventListener('change', sortCards);

      resetFiltersBtn.addEventListener('click', () => {
        searchInput.value = '';
        locationSelect.value = 'all';
        currentCategory = 'all';
        categoryChips.forEach((c, idx) => {
          if (idx === 0) {
            c.classList.add('bg-primary-container', 'text-on-primary', 'shadow-sm');
            c.classList.remove('bg-surface-container-lowest', 'text-on-surface');
          } else {
            c.classList.remove('bg-primary-container', 'text-on-primary', 'shadow-sm');
            c.classList.add('bg-surface-container-lowest', 'text-on-surface');
          }
        });
        applyFilters();
      });

      toggleEmptyDemo.addEventListener('click', () => {
        if (emptyState.classList.contains('hidden')) {
          providerGrid.classList.add('hidden');
          emptyState.classList.remove('hidden');
          emptyState.classList.add('flex');
          emptySearchTerm.textContent = 'braids in Polokwane';
          resultsCount.textContent = 'Showing 0 providers in Polokwane';
        } else {
          providerGrid.classList.remove('hidden');
          emptyState.classList.add('hidden');
          emptyState.classList.remove('flex');
          applyFilters();
        }
      });

      quickSuggestChips.forEach(chip => {
        chip.addEventListener('click', () => {
          const text = chip.innerText.trim();
          if (text.includes('Johannesburg')) {
            locationSelect.value = 'Rosebank';
          } else if (text.includes('Braiders')) {
            currentCategory = 'Braider';
            categoryChips.forEach(c => {
              if (c.dataset.cat === 'Braider') {
                c.classList.add('bg-primary-container', 'text-on-primary');
                c.classList.remove('bg-surface-container-lowest', 'text-on-surface');
              } else {
                c.classList.remove('bg-primary-container', 'text-on-primary');
                c.classList.add('bg-surface-container-lowest', 'text-on-surface');
              }
            });
          }
          applyFilters();
        });
      });
    })();
  </script>
</div></main><footer class="w-full bg-surface-container-low text-on-surface"><div class="max-w-[1200px] mx-auto px-margin lg:px-margin-desktop pt-space-xl pb-space-lg"><div class="grid grid-cols-1 md:grid-cols-4 gap-space-xl mb-space-xl"><div><p class="font-headline-md text-headline-md text-primary mb-space-md">Categories</p><ul class="space-y-space-sm"><li><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="barbershops" href="#">Barbershops</a></li><li><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="hair-braiding" href="#">Hair Braiding</a></li><li><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="nail-salons" href="#">Nail Salons</a></li><li><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="mobile-car-wash" href="#">Mobile Car Wash</a></li></ul></div><div><p class="font-headline-md text-headline-md text-primary mb-space-md">For Providers</p><ul class="space-y-space-sm"><li><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="get-booked" href="#">Get Booked</a></li><li><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="whatsapp-booking" href="#">WhatsApp Booking</a></li><li><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="provider-pricing" href="#">Pricing</a></li><li><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="merchant-app" href="#">Merchant App</a></li></ul></div><div><p class="font-headline-md text-headline-md text-primary mb-space-md">Company</p><ul class="space-y-space-sm"><li><a class="font-body-md text-body-md text-on-surface-variant hover:text-primary transition-colors" data-path="about-us" 