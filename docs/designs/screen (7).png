<link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/><style>@layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}</style><script src="https://cdn.tailwindcss.com"></script><script id="tailwind-config">tailwind.config={"darkMode":"class","theme":{"extend":{"colors":{"error-container":"#ffdad6","on-primary-fixed-variant":"#00504a","outline-variant":"#bdc9c6","surface-container-lowest":"#ffffff","surface-tint":"#006a63","on-secondary-container":"#684000","on-background":"#131b2e","on-tertiary-container":"#ffe5db","tertiary-fixed":"#ffdbce","secondary-fixed-dim":"#ffb95f","surface-bright":"#faf8ff","on-primary":"#ffffff","inverse-surface":"#283044","on-primary-container":"#a3faef","on-secondary-fixed":"#2a1700","tertiary-container":"#9c573a","primary-fixed-dim":"#80d5cb","on-error-container":"#93000a","secondary":"#855300","error":"#ba1a1a","surface-container":"#eaedff","on-primary-fixed":"#00201d","on-tertiary-fixed":"#370e00","inverse-on-surface":"#eef0ff","surface-container-low":"#f2f3ff","surface-dim":"#d2d9f4","on-secondary":"#ffffff","tertiary-fixed-dim":"#ffb598","on-surface":"#131b2e","on-tertiary":"#ffffff","on-error":"#ffffff","primary":"#005c55","on-secondary-fixed-variant":"#653e00","secondary-container":"#fea619","inverse-primary":"#80d5cb","surface-variant":"#dae2fd","primary-fixed":"#9cf2e8","tertiary":"#7f4025","primary-container":"#0f766e","on-tertiary-fixed-variant":"#72361b","surface-container-high":"#e2e7ff","secondary-fixed":"#ffddb8","background":"#faf8ff","outline":"#6e7977","on-surface-variant":"#3e4947","surface":"#faf8ff","surface-container-highest":"#dae2fd"},"borderRadius":{"DEFAULT":"0.25rem","lg":"0.5rem","xl":"0.75rem","full":"9999px"},"spacing":{"margin":"1rem","space-xs":"0.25rem","space-xl":"2rem","space-lg":"1.5rem","space-sm":"0.5rem","gutter":"1rem","gutter-desktop":"1.5rem","space-md":"1rem","margin-desktop":"2rem"},"fontFamily":{"headline-md":["Inter"],"price-display":["Inter"],"headline-lg":["Inter"],"body-sm":["Inter"],"headline-xl-mobile":["Inter"],"label-sm":["Inter"],"label-md":["Inter"],"headline-xl":["Inter"],"headline-lg-mobile":["Inter"],"body-lg":["Inter"],"body-md":["Inter"],"label-lg":["Inter"]},"fontSize":{"headline-md":["18px",{"lineHeight":"24px","letterSpacing":"0em","fontWeight":"600"}],"price-display":["20px",{"lineHeight":"26px","letterSpacing":"-0.01em","fontWeight":"700"}],"headline-lg":["24px",{"lineHeight":"32px","letterSpacing":"-0.01em","fontWeight":"600"}],"body-sm":["12px",{"lineHeight":"16px","letterSpacing":"0.01em","fontWeight":"400"}],"headline-xl-mobile":["26px",{"lineHeight":"34px","letterSpacing":"-0.015em","fontWeight":"700"}],"label-sm":["11px",{"lineHeight":"14px","letterSpacing":"0.04em","fontWeight":"600"}],"label-md":["14px",{"lineHeight":"20px","letterSpacing":"0.01em","fontWeight":"500"}],"headline-xl":["32px",{"lineHeight":"40px","letterSpacing":"-0.02em","fontWeight":"700"}],"headline-lg-mobile":["20px",{"lineHeight":"28px","letterSpacing":"-0.01em","fontWeight":"600"}],"body-lg":["16px",{"lineHeight":"24px","letterSpacing":"0em","fontWeight":"400"}],"body-md":["14px",{"lineHeight":"20px","letterSpacing":"0em","fontWeight":"400"}],"label-lg":["16px",{"lineHeight":"24px","letterSpacing":"0.01em","fontWeight":"600"}]}}}};</script></head><body class="bg-surface font-body-md text-body-md text-on-surface"><header class="fixed top-0 w-full z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]"><div class="h-20 max-w-[1200px] mx-auto px-margin lg:px-margin-desktop flex items-center justify-between gap-space-md"><div class="flex items-center gap-space-md"><img alt="ServiceFlow SA Logo" class="h-8 w-auto object-contain" src="https://lh3.googleusercontent.com/aida/ALJJyrA6jqmG5Op7hzKNb_DV2tZNii-IYGpBD8OgE_I4RoiCAH0uXs8d7kvH5YIPdg4P82mssbT9eIORilaw1iuTviyNqwcRNmiYled2ijkDYUyH_gDTyDAtemY57nFhCLFH9o5an42mKnQIX8PcKbv_MDxBAsqTMB0WB-LVc9oh-JmoEaNP07pjgghzLYEz2cnjDvjZhakV-Uol8BpY9NWn58hN8QtbQSFU8orWHLQUdOrKzA"/><span class="font-headline-lg text-headline-lg text-primary tracking-tight">ServiceFlow <span class="text-secondary-container">SA</span></span></div><nav class="hidden md:flex items-center gap-space-lg" data-active-classes="bg-primary-container text-on-primary-container font-label-md text-label-md rounded-lg"><a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors py-space-xs px-space-sm" data-path="categories" href="#">Categories</a><a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors py-space-xs px-space-sm" data-path="how-it-works" href="#">How it Works</a><a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors py-space-xs px-space-sm" data-path="for-providers" href="#">For Providers</a><a class="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors py-space-xs px-space-sm" data-path="pricing" href="#">Pricing</a></nav><div class="flex items-center gap-space-md"><a class="font-label-md text-label-md text-primary hover:text-primary-container transition-colors px-space-sm py-space-xs" data-path="login" href="#">Log In</a><a class="inline-flex items-center justify-center h-12 px-space-lg rounded-xl bg-primary-container text-on-primary font-label-md text-label-md shadow-[0_2px_6px_rgba(15,118,110,0.2)] hover:bg-primary transition-all duration-200 border-b-2 border-secondary-container" data-path="list-your-business" href="#">List Your Business</a><div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center"><span class="material-symbols-outlined text-on-primary text-[18px]">person</span></div></div></div></header><main class="w-full pt-20 bg-surface min-h-[calc(100vh-80px)]"><div class="flex flex-col w-full">
<!-- Interactive Header, Search & Filter Section -->
<section class="w-full bg-surface-container-low/70 py-space-xl px-margin lg:px-margin-desktop">
<div class="max-w-[1200px] mx-auto flex flex-col gap-space-lg">
<!-- Breadcrumb & Header Titles -->
<div class="flex flex-col gap-space-xs">
<div class="flex items-center gap-space-xs text-on-surface-variant font-label-sm text-label-sm">
<a class="hover:text-primary transition-colors" href="#">Home</a>
<span class="material-symbols-outlined text-[14px]">chevron_right</span>
<span class="text-primary font-semibold">Service Directory</span>
</div>
<div class="flex flex-col md:flex-row md:items-end justify-between gap-space-md mt-space-xs">
<div>
<h1 class="font-headline-xl text-headline-xl text-on-surface tracking-tight">
              Find Verified Barbers, Braiders, Nail Techs &amp; Mobile Pros in SA
            </h1>
<p class="font-body-lg text-body-lg text-on-surface-variant mt-1">
              Instant bookings, automated WhatsApp updates, and vetted South African professionals.
            </p>
</div>
<div class="hidden lg:flex items-center gap-2 bg-surface-container-lowest px-4 py-2 rounded-full shadow-sm">
<span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
<span class="font-label-md text-label-md text-primary font-semibold">420+ Verified Pros Active Now</span>
</div>
</div>
</div>
<!-- Core Search & Location Filter Bar -->
<div class="bg-surface-container-lowest rounded-xl p-space-sm md:p-space-md shadow-md flex flex-col lg:flex-row items-stretch gap-space-sm">
<!-- Text Query Input -->
<div class="flex-1 flex items-center gap-space-sm bg-surface-container-low px-space-md py-2.5 rounded-lg">
<span class="material-symbols-outlined text-outline">search</span>
<input class="bg-transparent border-0 outline-none w-full font-body-md text-body-md text-on-surface placeholder:text-outline focus:ring-0" id="searchInput" placeholder="Search by pro name, service, or salon..." type="text"/>
</div>
<!-- Location Dropdown -->
<div class="relative flex-1 md:max-w-xs flex items-center gap-space-sm bg-surface-container-low px-space-md py-2.5 rounded-lg">
<span class="material-symbols-outlined text-outline">location_on</span>
<select class="w-full bg-transparent border-0 outline-none font-body-md text-body-md text-on-surface focus:ring-0 cursor-pointer appearance-none pr-8" id="locationSelect">
<option value="all">All Locations (Gauteng, Western Cape, KZN)</option>
<option value="Rosebank">Rosebank, Johannesburg</option>
<option value="Sandton">Sandton &amp; Soweto</option>
<option value="Cape Town">Cape Town CBD</option>
<option value="Randburg">Randburg &amp; Midrand</option>
<option value="Durban">Durban North &amp; Umhlanga</option>
<option value="Maboneng">Maboneng, Johannesburg</option>
<option value="Polokwane">Polokwane (Limpopo)</option>
</select>
<span class="material-symbols-outlined absolute right-3 pointer-events-none text-outline text-[20px]">expand_more</span>
</div>
<!-- Sort Select -->
<div class="relative flex-1 md:max-w-[200px] flex items-center gap-space-sm bg-surface-container-low px-space-md py-2.5 rounded-lg">
<span class="material-symbols-outlined text-outline">tune</span>
<select class="w-full bg-transparent border-0 outline-none font-body-md text-body-md text-on-surface focus:ring-0 cursor-pointer appearance-none pr-8" id="sortSelect">
<option value="recommended">Recommended</option>
<option value="rating">Highest Rated</option>
<option value="price-low">Lowest Price</option>
</select>
<span class="material-symbols-outlined absolute right-3 pointer-events-none text-outline text-[20px]">expand_more</span>
</div>
<!-- Search Action Button -->
<button class="h-12 px-6 rounded-lg bg-primary-container text-on-primary font-label-md text-label-md font-semibold hover:bg-primary transition-all duration-200 flex items-center justify-center gap-2 shadow-sm" id="searchBtn">
<span>Search</span>
<span class="material-symbols-outlined text-[18px]">east</span>
</button>
</div>
<!-- Category Filter Chips Slider -->
<div class="flex items-center gap-space-xs overflow-x-auto pb-1 scrollbar-none" id="categoryChips">
<button class="category-chip px-4 py-2 rounded-full font-label-md text-label-md font-semibold transition-all duration-200 flex items-center gap-2 bg-primary-container text-on-primary shadow-sm whitespace-nowrap" data-cat="all">
<span>All Providers</span>
<span class="bg-primary/40 px-2 py-0.5 rounded-full text-label-sm font-bold">420+</span>
</button>
<button class="category-chip px-4 py-2 rounded-full font-label-md text-label-md font-medium transition-all duration-200 flex items-center gap-2 bg-surface-container-lowest text-on-surface hover:bg-surface-container whitespace-nowrap" data-cat="Barber">
<span>✂️ Barbers</span>
</button>
<button class="category-chip px-4 py-2 rounded-full font-label-md text-label-md font-medium transition-all duration-200 flex items-center gap-2 bg-surface-container-lowest text-on-surface hover:bg-surface-container whitespace-nowrap" data-cat="Braider">
<span>✨ Braiders &amp; Hair</span>
</button>
<button class="category-chip px-4 py-2 rounded-full font-label-md text-label-md font-medium transition-all duration-200 flex items-center gap-2 bg-surface-container-lowest text-on-surface hover:bg-surface-container whitespace-nowrap" data-cat="Nail Tech">
<span>💅 Nail Techs</span>
</button>
<button class="category-chip px-4 py-2 rounded-full font-label-md text-label-md font-medium transition-all duration-200 flex items-center gap-2 bg-surface-container-lowest text-on-surface hover:bg-surface-container whitespace-nowrap" data-cat="Mobile Car Wash">
<span>🚗 Mobile Car Wash</span>
</button>
<button class="category-chip px-4 py-2 rounded-full font-label-md text-label-md font-medium transition-all duration-200 flex items-center gap-2 bg-surface-container-lowest text-on-surface hover:bg-surface-container whitespace-nowrap" data-cat="Spa">
<span>💆 Massage &amp; Spa</span>
</button>
<button class="category-chip px-4 py-2 rounded-full font-label-md text-label-md font-medium transition-all duration-200 flex items-center gap-2 bg-surface-container-lowest text-on-surface hover:bg-surface-container whitespace-nowrap" data-cat="Makeup">
<span>💄 Makeup &amp; Lashes</span>
</button>
</div>
<!-- Quick Toggles & Active Filter Summary -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-sm pt-space-xs text-on-surface-variant font-body-sm text-body-sm">
<div class="flex items-center gap-space-sm">
<span class="font-semibold text-on-surface font-label-md text-label-md" id="resultsCount">Showing 6 featured providers</span>
<span class="inline-block w-1.5 h-1.5 rounded-full bg-outline-variant"></span>
<span>Verified Mzansi talent ready to book</span>
</div>
<div class="flex items-center gap-space-md flex-wrap">
<label class="flex items-center gap-2 cursor-pointer select-none">
<input checked="" class="w-4 h-4 rounded text-primary focus:ring-primary-container accent-primary-container" id="verifiedOnly" type="checkbox"/>
<span class="font-label-sm text-label-sm font-semibold text-on-surface">Verified pros only</span>
</label>
<label class="flex items-center gap-2 cursor-pointer select-none">
<input class="w-4 h-4 rounded text-primary focus:ring-primary-container accent-primary-container" id="availableWeek" type="checkbox"/>
<span class="font-label-sm text-label-sm font-semibold text-on-surface">Available this week</span>
</label>
</div>
</div>
</div>
</section>
<!-- Provider Directory Grid Section -->
<section class="w-full max-w-[1200px] mx-auto px-margin lg:px-margin-desktop py-space-xl">
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-lg" id="providerGrid">
<!-- Card 1 -->
<article class="provider-card flex flex-col bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 group" data-category="Barber" data-location="Rosebank" data-price="180" data-rating="4.9" data-verified="true">
<div class="relative h-52 w-full overflow-hidden bg-surface-container-high">
<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" data-alt="Close-up of Sipho crafting a sharp taper fade haircut with precision clippers in a sunlit modern Rosebank barber studio, rich warm tones and ambient teal styling accents, authentic South African craftsmanship." src="https://lh3.googleusercontent.com/aida-public/AB6AXuB3abt44UlbB4Mgzp6F7qXTnZ2vEiMcNCmYfW4EjWu9itFSDkHdsajQPLELyVAjTKrUCaIYgFbs3oRxQ8dYOXMvL6Cg--9NNBHOzmf8Q2NG0rJKAVXAJmNWBHs0ekguNvGyuhuJ6sPSg5LgX2Jz6xj7P6mFqWbC2QqT6xyNYreSvZnroAGoJg5oQfjYm-B4831pXxNXZud8xvPUClck0xc_d1C6nNPxtOhvZsd2FK6B"/>
<div class="absolute inset-0 bg-gradient-to-t from-surface-container-highest/80 via-transparent to-black/20"></div>
<div class="absolute top-3 left-3 flex items-center gap-1.5 bg-surface-container-lowest/95 backdrop-blur-md px-2.5 py-1 rounded-full shadow-sm">
<span class="w-2 h-2 rounded-full bg-emerald-500"></span>
<span class="font-label-sm text-label-sm text-on-surface font-semibold">Available Today</span>
</div>
<div class="absolute top-3 right-3 bg-primary-container text-on-primary flex items-center gap-1 px-2.5 py-1 rounded-full font-label-sm text-label-sm font-bold shadow-sm">
<span class="material-symbols-outlined text-[14px]">verified</span>
<span>Verified Pro</span>
</div>
<span class="absolute bottom-3 left-3 bg-surface-container-lowest/90 backdrop-blur-md text-on-surface font-label-sm text-label-sm font-bold px-2.5 py-1 rounded-md">
            ✂️ Barbering
          </span>
</div>
<div class="p-space-md flex-1 flex flex-col justify-between gap-space-md">
<div>
<div class="flex items-start justify-between gap-2">
<h2 class="font-headline-md text-headline-md text-on-surface group-hover:text-primary transition-colors">
                Sipho's Cuts &amp; Fades
              </h2>
<div class="flex items-center gap-1 shrink-0 bg-amber-50 px-2 py-0.5 rounded text-amber-700">
<span class="material-symbols-outlined text-amber-500 text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="font-label-md text-label-md font-bold">4.9</span>
<span class="font-body-sm text-body-sm text-outline">(124)</span>
</div>
</div>
<div class="flex items-center gap-1 text-on-surface-variant font-body-sm text-body-sm mt-1">
<span class="material-symbols-outlined text-[16px] text-primary">location_on</span>
<span class="truncate">Rosebank, Johannesburg</span>
</div>
<p class="font-body-md text-body-md text-on-surface-variant mt-space-sm line-clamp-2">
              Master barber specializing in taper fades, clean beard trims, hot towel treatments and Afro-hair sculpting.
            </p>
</div>
<div class="pt-space-sm flex items-center justify-between gap-space-sm">
<div>
<span class="block font-body-sm text-body-sm text-on-surface-variant font-medium">Starting from</span>
<span class="font-price-display text-price-display text-primary font-bold">R180</span>
</div>
<button class="h-11 px-5 rounded-lg bg-primary-container text-on-primary font-label-md text-label-md font-semibold hover:bg-primary transition-all duration-200 flex items-center gap-1.5 shadow-sm">
<span>Book Now</span>
<span class="material-symbols-outlined text-[18px]">calendar_month</span>
</button>
</div>
</div>
</article>
<!-- Card 2 -->
<article class="provider-card flex flex-col bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 group" data-category="Braider" data-location="Sandton" data-price="350" data-rating="5.0" data-verified="true">
<div class="relative h-52 w-full overflow-hidden bg-surface-container-high">
<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" data-alt="Intricate golden blonde and brunette knotless braids styled elegantly in an upscale Sandton salon studio with natural sunlight and warm greenery details, modern South African high-end hair design." src="https://lh3.googleusercontent.com/aida-public/AB6AXuDO9kEYIyivkilWs03ERByihDxp4ayjGYXVdmp_hIpG8O7gq8wJKTV_6caaQFsvTwq2WZoGY55GYbd_YOqjrjJMXSfAPk6WV3L2iHh_isPHtrsMDVF_3ezJQcHJgdrls3tVOeryH1JxeU5XS8iHg7tag28k08TU5XXzoo6yJNyzdzixK1dNeS6jh6LNNiWyXZoKnV4fLBLb876iBFeWUZpeD3V7QY7iEMgkZy4M3uEQ"/>
<div class="absolute inset-0 bg-gradient-to-t from-surface-container-highest/80 via-transparent to-black/20"></div>
<div class="absolute top-3 left-3 flex items-center gap-1.5 bg-surface-container-lowest/95 backdrop-blur-md px-2.5 py-1 rounded-full shadow-sm">
<span class="w-2 h-2 rounded-full bg-secondary-container"></span>
<span class="font-label-sm text-label-sm text-on-surface font-semibold">Next slot tomorrow</span>
</div>
<div class="absolute top-3 right-3 bg-primary-container text-on-primary flex items-center gap-1 px-2.5 py-1 rounded-full font-label-sm text-label-sm font-bold shadow-sm">
<span class="material-symbols-outlined text-[14px]">verified</span>
<span>Verified Pro</span>
</div>
<span class="absolute bottom-3 left-3 bg-surface-container-lowest/90 backdrop-blur-md text-on-surface font-label-sm text-label-sm font-bold px-2.5 py-1 rounded-md">
            ✨ Braiding &amp; Hair
          </span>
</div>
<div class="p-space-md flex-1 flex flex-col justify-between gap-space-md">
<div>
<div class="flex items-start justify-between gap-2">
<h2 class="font-headline-md text-headline-md text-on-surface group-hover:text-primary transition-colors">
                Naledi Crown Artistry
              </h2>
<div class="flex items-center gap-1 shrink-0 bg-amber-50 px-2 py-0.5 rounded text-amber-700">
<span class="material-symbols-outlined text-amber-500 text-[16px]" style="font-variation-settings: 'FILL' 1;">star</span>
<span class="font-label-md text-label-md font-bold">5.0</span>
<span class="font-body-sm text-body-sm text-outline">(89)</span>
</div>
</div>
<div class="flex items-center gap-1 text-on-surface-variant font-body-sm text-body-sm mt-1">
<span class="material-symbols-outlined text-[16px] text-primary">location_on</span>
<span class="truncate">Sandton &amp; Soweto</span>
</div>
<p class="font-body-md text-body-md text-on-surface-variant mt-space-sm line-clamp-2">
              Gentle knotless braids, boho locs, passion twists and cornrows. Pain-free tension control and custom parting.
            </p>
</div>
<div class="pt-space-sm flex items-center justify-between gap-space-sm">
<div>
<span class="block font-body-sm text-body-sm text-on-surface-variant font-medium">Starting from</span>
<span class="font-price-display text-price-display text-primary font-bold">R350</span>
</div>
<button class="h-11 px-5 rounded-lg bg-primary-container text-on-primary font-label-md text-label-md font-semibold hover:bg-primary transition-all duration-200 flex items-center gap-1.5 shadow-sm">
<span>Book Now</span>
<span class="material-symbols-outlined text-[18px]">calendar_month</span>
</button>
</div>
</div>
</article>
<!-- Card 3 -->
<article class="provider-card flex flex-col bg-surface-container-lowest rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-300 group" data-category="Nail Tech" data-location="Cape Town" data-price="280" data-rating="4.9" data-verified="true">
<div class="relative h-52 w-full overflow-hidden bg-surface-container-high">
<img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" data-alt="Pristine Russian manicure with BIAB builder gel and minimalist chrome nail art, displayed on soft velvet cushion inside a chic Cape Town CBD studio with mountain views in soft focus background." src="https://lh3.googleusercontent.com/aida-public/AB6AXuAhHSjGBTm3m1N8ZsAj2QR9YRQUPwgdOxc-TKohaB-dboHxjGJM62-J8h2TyMDEyzufKapRgD_hD-O_sS93bPQMwiuNaGfWIUC-RYS1PzOuQ8Q-AZoNrUywPsRH29KKB98plEXP9kUnZ4w64RXWkVDnHiEeuGMs-KvGSXV7GaMwvcHiBhpTGjiTDPVsJxxvTia3U2EXeK7btoFjX-3RQSv-NMo0nbteV2DwQrc9NKwF"/>
<div class="absolute inset-0 bg-gradient-to-t from-surface-container-highest/80 via-transparent to-black/20"></div>
